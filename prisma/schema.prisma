generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // This project is CommonJS (no "type": "module" in package.json,
  // tsconfig targets nodenext-as-CJS). Prisma 7's client generator is
  // ESM-first by default (emits `import.meta.url`, which has no valid
  // CommonJS transpilation) — moduleFormat = "cjs" makes it emit
  // require()-compatible output instead.
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes", "views"]
}

datasource db {
  provider = "postgresql"
}

// Money columns are modeled as `Decimal` (matching the underlying Postgres
// `numeric` type exactly, no floating-point rounding risk), not `Float`.
// Prisma Client returns `Prisma.Decimal` instances for these fields —
// services must call `.toNumber()` at the point they build a response
// DTO/GraphQL model, exactly as they already convert `Date` -> ISO string
// today. This keeps the public REST/GraphQL API contract (plain `number`)
// unchanged; only the internal Prisma<->service boundary is Decimal-aware.

model Address {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @unique(map: "addresses_user_id_default_unique", where: raw("(is_default = true)")) @map("user_id") @db.Uuid
  street     String   @db.VarChar(255)
  city       String   @db.VarChar(100)
  state      String   @db.VarChar(100)
  postalCode String   @map("postal_code") @db.VarChar(20)
  country    String   @db.VarChar(100)
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "addresses_user_id_users_id_fkey")

  // NOTE: `userId` carries a PARTIAL unique index (only rows where
  // isDefault = true participate — "at most one default address per user",
  // not "at most one address per user"). A user can have many Address rows;
  // see User.addresses below, deliberately typed as a list despite this
  // @unique attribute (introspection defaults to inferring a 1:1 relation
  // from any @unique on the FK, which would be wrong here).
  @@index([userId])
  @@map("addresses")
}

/// This model contains an expression index (brands_name_lower_unique, on
/// lower(name)) which Prisma cannot represent — see the baseline migration's
/// hand-authored raw SQL. The DB still enforces it regardless.
model Brand {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(100)
  slug        String    @unique(map: "brands_slug_unique") @db.VarChar(120)
  description String?
  logoUrl     String?   @map("logo_url")
  website     String?   @db.VarChar(255)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  products    Product[]

  @@index([isActive], map: "brands_active_idx")
  @@map("brands")
}

/// This table contains check constraints (cart_items_quantity_positive) not
/// representable by Prisma — see the baseline migration's raw SQL.
model CartItem {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId        String   @map("cart_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  quantity      Int
  priceSnapshot Decimal  @map("price_snapshot") @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  cart          Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cart_items_cart_id_carts_id_fkey")
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "cart_items_product_id_products_id_fkey")

  @@unique([cartId, productId], map: "cart_items_cart_id_product_id_unique")
  @@index([cartId])
  @@map("cart_items")
}

model Cart {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String     @unique(map: "carts_user_id_unique") @map("user_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  cartItems CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "carts_user_id_users_id_fkey")

  @@map("carts")
}

model Category {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String     @db.VarChar(100)
  slug        String     @unique(map: "categories_slug_unique") @db.VarChar(120)
  description String?
  parentId    String?    @map("parent_id") @db.Uuid
  sortOrder   Int        @default(0) @map("sort_order")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "categories_parent_id_categories_id_fkey")
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  @@index([isActive], map: "categories_active_idx")
  @@index([parentId])
  @@map("categories")
}

/// This table contains check constraints (coupons_min_purchase_non_negative,
/// coupons_percentage_range, coupons_usage_limit_positive,
/// coupons_value_positive) and an expression index (coupons_code_unique, on
/// upper(code)) not representable by Prisma — see the baseline migration.
model Coupon {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String     @db.VarChar(50)
  type        CouponType
  value       Decimal    @db.Decimal(10, 2)
  minPurchase Decimal    @default(0) @map("min_purchase") @db.Decimal(10, 2)
  usageLimit  Int?       @map("usage_limit")
  usageCount  Int        @default(0) @map("usage_count")
  expiresAt   DateTime?  @map("expires_at") @db.Timestamptz(6)
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("coupons")
}

/// This table contains check constraints (inventory_reserved_stock_non_negative,
/// inventory_sold_stock_non_negative) not representable by Prisma — see the
/// baseline migration's raw SQL.
model Inventory {
  productId     String   @id @map("product_id") @db.Uuid
  reservedStock Int      @default(0) @map("reserved_stock")
  soldStock     Int      @default(0) @map("sold_stock")
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "inventory_product_id_products_id_fkey")

  @@map("inventory")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String    @db.VarChar(50)
  title     String    @db.VarChar(200)
  message   String
  metadata  Json?
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "notifications_user_id_users_id_fkey")

  @@index([userId])
  @@index([userId], map: "notifications_user_id_unread_idx", where: raw("(read_at IS NULL)"))
  @@map("notifications")
}

/// This table contains check constraints (order_items_quantity_positive,
/// order_items_unit_price_non_negative) not representable by Prisma — see
/// the baseline migration's raw SQL.
model OrderItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  productName String   @map("product_name") @db.VarChar(200)
  productSku  String   @map("product_sku") @db.VarChar(64)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  quantity    Int
  taxAmount   Decimal  @default(0) @map("tax_amount") @db.Decimal(10, 2)
  lineTotal   Decimal  @map("line_total") @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "order_items_order_id_orders_id_fkey")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "order_items_product_id_products_id_fkey")

  @@index([orderId])
  @@map("order_items")
}

/// This table contains check constraints (orders_discount_amount_non_negative,
/// orders_subtotal_non_negative, orders_total_non_negative) not representable
/// by Prisma — see the baseline migration's raw SQL.
model Order {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  status          OrderStatus @default(pending)
  subtotal        Decimal     @db.Decimal(10, 2)
  discountAmount  Decimal     @default(0) @map("discount_amount") @db.Decimal(10, 2)
  couponCode      String?     @map("coupon_code") @db.VarChar(50)
  shippingAddress Json        @map("shipping_address")
  total           Decimal     @db.Decimal(10, 2)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  orderItems      OrderItem[]
  user            User        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "orders_user_id_users_id_fkey")
  // One order can accumulate multiple payment attempts (a failed card, a
  // retry) — see Payment.orderId's partial unique (at most one *successful*
  // payment per order, not "at most one payment per order").
  payments        Payment[]

  @@index([status])
  @@index([userId])
  @@map("orders")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "password_reset_tokens_token_hash_unique") @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "password_reset_tokens_user_id_users_id_fkey")

  @@index([userId])
  @@map("password_reset_tokens")
}

/// This table contains check constraints (payments_amount_positive) not
/// representable by Prisma — see the baseline migration's raw SQL.
model Payment {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId              String          @unique(map: "payments_order_id_success_unique", where: raw("(status = 'success'::payment_status)")) @map("order_id") @db.Uuid
  provider             PaymentProvider
  status               PaymentStatus   @default(pending)
  amount               Decimal         @db.Decimal(10, 2)
  transactionReference String?         @map("transaction_reference") @db.VarChar(255)
  gatewayResponse      Json?           @map("gateway_response")
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  order                Order           @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "payments_order_id_orders_id_fkey")

  // NOTE: `orderId` carries a PARTIAL unique index (only rows where
  // status = 'success' participate). See Order.payments — deliberately a
  // list, not a to-one relation.
  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model ProductImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String
  altText   String?  @map("alt_text") @db.VarChar(255)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_images_product_id_products_id_fkey")

  @@index([productId])
  @@map("product_images")
}

/// This table contains check constraints (products_discount_percentage_range,
/// products_price_non_negative, products_stock_non_negative) not
/// representable by Prisma — see the baseline migration's raw SQL.
model Product {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String                  @db.VarChar(200)
  slug               String                  @unique(map: "products_slug_unique") @db.VarChar(220)
  description        String?
  sku                String                  @unique(map: "products_sku_unique") @db.VarChar(64)
  price              Decimal                 @db.Decimal(10, 2)
  discountPercentage Int?                    @map("discount_percentage")
  stock              Int                     @default(0)
  weightKg           Decimal?                @map("weight_kg") @db.Decimal(8, 3)
  dimensionsCm       Json?                   @map("dimensions_cm")
  specifications     Json                    @default("{}")
  categoryId         String                  @map("category_id") @db.Uuid
  brandId            String?                 @map("brand_id") @db.Uuid
  status             ProductStatus           @default(draft)
  // DB-generated (STORED, GENERATED ALWAYS AS to_tsvector(...)) — never
  // written to via Prisma Client (Unsupported fields are write-excluded);
  // read only via $queryRaw in the full-text search path.
  searchVector       Unsupported("tsvector") @default(dbgenerated("to_tsvector('english'::regconfig, (((COALESCE(name, ''::character varying))::text || ' '::text) || COALESCE(description, ''::text)))")) @map("search_vector")
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)
  cartItems          CartItem[]
  inventory          Inventory?
  orderItems         OrderItem[]
  productImages      ProductImage[]
  brand              Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "products_brand_id_brands_id_fkey")
  category           Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "products_category_id_categories_id_fkey")
  reviews            Review[]
  wishlistItems      WishlistItem[]

  @@index([brandId])
  @@index([categoryId])
  @@index([price])
  @@index([searchVector], type: Gin)
  @@index([status])
  @@map("products")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "refresh_tokens_token_hash_unique") @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "refresh_tokens_user_id_users_id_fkey")

  @@index([userId])
  @@map("refresh_tokens")
}

/// This table contains check constraints (reviews_rating_range) not
/// representable by Prisma — see the baseline migration's raw SQL.
model Review {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "reviews_product_id_products_id_fkey")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "reviews_user_id_users_id_fkey")

  @@unique([productId, userId], map: "reviews_product_id_user_id_unique")
  @@index([productId])
  @@map("reviews")
}

/// This model contains an expression index (users_email_unique, on
/// lower(email)) which Prisma cannot represent — see the baseline
/// migration's hand-authored raw SQL. The DB still enforces it regardless.
model User {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName           String               @map("first_name") @db.VarChar(100)
  lastName            String               @map("last_name") @db.VarChar(100)
  email               String               @db.VarChar(255)
  password            String
  phone               String?              @db.VarChar(20)
  avatar              String?
  isActive            Boolean              @default(true) @map("is_active")
  emailVerified       Boolean              @default(false) @map("email_verified")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  role                Role                 @default(customer)
  // See Address.userId — deliberately a list despite the partial @unique
  // on the other side (only one row may have isDefault = true).
  addresses           Address[]
  cart                Cart?
  notifications       Notification[]
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  reviews             Review[]
  wishlistItems       WishlistItem[]

  @@index([isActive], map: "users_active_idx")
  @@index([role])
  @@map("users")
}

model WishlistItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "wishlist_items_product_id_products_id_fkey")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "wishlist_items_user_id_users_id_fkey")

  @@unique([userId, productId], map: "wishlist_items_user_id_product_id_unique")
  @@index([userId])
  @@map("wishlist_items")
}

view BestSellingProductsView {
  productId String?  @map("product_id") @db.Uuid
  name      String?  @db.VarChar(200)
  slug      String?  @db.VarChar(220)
  unitsSold Int?     @map("units_sold")
  revenue   Decimal? @db.Decimal

  @@map("best_selling_products_view")
}

view LowStockProductsView {
  id         String? @db.Uuid
  name       String? @db.VarChar(200)
  sku        String? @db.VarChar(64)
  stock      Int?
  categoryId String? @map("category_id") @db.Uuid

  @@map("low_stock_products_view")
}

view MonthlySalesView {
  month      DateTime? @db.Timestamptz(6)
  orderCount Int?      @map("order_count")
  revenue    Decimal?  @db.Decimal

  @@map("monthly_sales_view")
}

enum CouponType {
  percentage
  flat

  @@map("coupon_type")
}

enum OrderStatus {
  pending
  paid
  processing
  shipped
  delivered
  cancelled
  refunded

  @@map("order_status")
}

enum PaymentProvider {
  cash
  stripe
  sslcommerz
  paypal

  @@map("payment_provider")
}

enum PaymentStatus {
  pending
  success
  failed
  refunded

  @@map("payment_status")
}

enum ProductStatus {
  draft
  active
  archived

  @@map("product_status")
}

enum Role {
  customer
  admin

  @@map("role")
}
