enum coupon_type {
  percentage
  flat
}

enum order_status {
  pending
  paid
  processing
  shipped
  delivered
  cancelled
  refunded
}

enum payment_provider {
  cash
  stripe
  sslcommerz
  paypal
}

enum payment_status {
  pending
  success
  failed
  refunded
}

enum product_status {
  draft
  active
  archived
}

enum role {
  customer
  admin
}

table addresses {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  street varchar(255) [not null]
  city varchar(100) [not null]
  state varchar(100) [not null]
  postal_code varchar(20) [not null]
  country varchar(100) [not null]
  is_default boolean [not null, default: false]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    user_id [name: 'addresses_user_id_idx']
    user_id [name: 'addresses_user_id_default_unique', unique]
  }
}

table brands {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  name varchar(100) [not null]
  slug varchar(120) [not null]
  description text
  logo_url text
  website varchar(255)
  is_active boolean [not null, default: true]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    slug [name: 'brands_slug_unique', unique]
    name [name: 'brands_name_lower_unique', unique]
    is_active [name: 'brands_active_idx']
  }
}

table cart_items {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  cart_id uuid [not null]
  product_id uuid [not null]
  quantity integer [not null]
  price_snapshot "numeric(10, 2)" [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (cart_id, product_id) [name: 'cart_items_cart_id_product_id_unique', unique]
    cart_id [name: 'cart_items_cart_id_idx']
    
  }
}

table carts {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    user_id [name: 'carts_user_id_unique', unique]
  }
}

table categories {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  name varchar(100) [not null]
  slug varchar(120) [not null]
  description text
  parent_id uuid
  sort_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    slug [name: 'categories_slug_unique', unique]
    parent_id [name: 'categories_parent_id_idx']
    is_active [name: 'categories_active_idx']
  }
}

table coupons {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  code varchar(50) [not null]
  type coupon_type [not null]
  value "numeric(10, 2)" [not null]
  min_purchase "numeric(10, 2)" [not null, default: 0]
  usage_limit integer
  usage_count integer [not null, default: 0]
  expires_at "timestamp with time zone"
  is_active boolean [not null, default: true]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    code [name: 'coupons_code_unique', unique]
    
    
    
    
  }
}

table inventory {
  product_id uuid [pk, not null]
  reserved_stock integer [not null, default: 0]
  sold_stock integer [not null, default: 0]
  updated_at "timestamp with time zone" [not null, default: `now()`]
}

table notifications {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  type varchar(50) [not null]
  title varchar(200) [not null]
  message text [not null]
  metadata jsonb
  read_at "timestamp with time zone"
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    user_id [name: 'notifications_user_id_idx']
    user_id [name: 'notifications_user_id_unread_idx']
  }
}

table order_items {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  order_id uuid [not null]
  product_id uuid [not null]
  product_name varchar(200) [not null]
  product_sku varchar(64) [not null]
  unit_price "numeric(10, 2)" [not null]
  quantity integer [not null]
  tax_amount "numeric(10, 2)" [not null, default: 0]
  line_total "numeric(10, 2)" [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    order_id [name: 'order_items_order_id_idx']
    
    
  }
}

table orders {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  status order_status [not null, default: 'pending']
  subtotal "numeric(10, 2)" [not null]
  discount_amount "numeric(10, 2)" [not null, default: 0]
  coupon_code varchar(50)
  shipping_address jsonb [not null]
  total "numeric(10, 2)" [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    user_id [name: 'orders_user_id_idx']
    status [name: 'orders_status_idx']
    
    
    
  }
}

table password_reset_tokens {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  token_hash varchar(64) [not null]
  expires_at "timestamp with time zone" [not null]
  used_at "timestamp with time zone"
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    token_hash [name: 'password_reset_tokens_token_hash_unique', unique]
    user_id [name: 'password_reset_tokens_user_id_idx']
  }
}

table payments {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  order_id uuid [not null]
  provider payment_provider [not null]
  status payment_status [not null, default: 'pending']
  amount "numeric(10, 2)" [not null]
  transaction_reference varchar(255)
  gateway_response jsonb
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    order_id [name: 'payments_order_id_idx']
    status [name: 'payments_status_idx']
    order_id [name: 'payments_order_id_success_unique', unique]
    
  }
}

table product_images {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  product_id uuid [not null]
  url text [not null]
  alt_text varchar(255)
  sort_order integer [not null, default: 0]
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    product_id [name: 'product_images_product_id_idx']
  }
}

table products {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  name varchar(200) [not null]
  slug varchar(220) [not null]
  description text
  sku varchar(64) [not null]
  price "numeric(10, 2)" [not null]
  discount_percentage integer
  stock integer [not null, default: 0]
  weight_kg "numeric(8, 3)"
  dimensions_cm jsonb
  specifications jsonb [not null, default: `{}`]
  category_id uuid [not null]
  brand_id uuid
  status product_status [not null, default: 'draft']
  search_vector tsvector [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    slug [name: 'products_slug_unique', unique]
    sku [name: 'products_sku_unique', unique]
    category_id [name: 'products_category_id_idx']
    brand_id [name: 'products_brand_id_idx']
    status [name: 'products_status_idx']
    price [name: 'products_price_idx']
    search_vector [name: 'products_search_vector_idx']
    
    
    
  }
}

table refresh_tokens {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  token_hash varchar(64) [not null]
  expires_at "timestamp with time zone" [not null]
  revoked_at "timestamp with time zone"
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    token_hash [name: 'refresh_tokens_token_hash_unique', unique]
    user_id [name: 'refresh_tokens_user_id_idx']
  }
}

table reviews {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  product_id uuid [not null]
  user_id uuid [not null]
  rating integer [not null]
  comment text
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (product_id, user_id) [name: 'reviews_product_id_user_id_unique', unique]
    product_id [name: 'reviews_product_id_idx']
    
  }
}

table users {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  email varchar(255) [not null]
  password text [not null]
  phone varchar(20)
  avatar text
  role role [not null, default: 'customer']
  is_active boolean [not null, default: true]
  email_verified boolean [not null, default: false]
  created_at "timestamp with time zone" [not null, default: `now()`]
  updated_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    email [name: 'users_email_unique', unique]
    email [name: 'users_email_idx']
    is_active [name: 'users_active_idx']
    role [name: 'users_role_idx']
  }
}

table wishlist_items {
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null]
  product_id uuid [not null]
  created_at "timestamp with time zone" [not null, default: `now()`]

  indexes {
    (user_id, product_id) [name: 'wishlist_items_user_id_product_id_unique', unique]
    user_id [name: 'wishlist_items_user_id_idx']
  }
}

ref addresses_user_id_users_id_fk: addresses.user_id > users.id [delete: cascade, update: no action]

ref cart_items_cart_id_carts_id_fk: cart_items.cart_id > carts.id [delete: cascade, update: no action]

ref cart_items_product_id_products_id_fk: cart_items.product_id > products.id [delete: cascade, update: no action]

ref carts_user_id_users_id_fk: carts.user_id > users.id [delete: cascade, update: no action]

ref categories_parent_id_categories_id_fk: categories.parent_id > categories.id [delete: restrict, update: no action]

ref inventory_product_id_products_id_fk: inventory.product_id > products.id [delete: cascade, update: no action]

ref notifications_user_id_users_id_fk: notifications.user_id > users.id [delete: cascade, update: no action]

ref order_items_order_id_orders_id_fk: order_items.order_id > orders.id [delete: cascade, update: no action]

ref order_items_product_id_products_id_fk: order_items.product_id > products.id [delete: restrict, update: no action]

ref orders_user_id_users_id_fk: orders.user_id > users.id [delete: restrict, update: no action]

ref password_reset_tokens_user_id_users_id_fk: password_reset_tokens.user_id > users.id [delete: cascade, update: no action]

ref payments_order_id_orders_id_fk: payments.order_id > orders.id [delete: restrict, update: no action]

ref product_images_product_id_products_id_fk: product_images.product_id > products.id [delete: cascade, update: no action]

ref products_category_id_categories_id_fk: products.category_id > categories.id [delete: restrict, update: no action]

ref products_brand_id_brands_id_fk: products.brand_id > brands.id [delete: set null, update: no action]

ref refresh_tokens_user_id_users_id_fk: refresh_tokens.user_id > users.id [delete: cascade, update: no action]

ref reviews_product_id_products_id_fk: reviews.product_id > products.id [delete: cascade, update: no action]

ref reviews_user_id_users_id_fk: reviews.user_id > users.id [delete: cascade, update: no action]

ref wishlist_items_user_id_users_id_fk: wishlist_items.user_id > users.id [delete: cascade, update: no action]

ref wishlist_items_product_id_products_id_fk: wishlist_items.product_id > products.id [delete: cascade, update: no action]